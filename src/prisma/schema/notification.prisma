model Notification {
    id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
    type      String
    content   String
    createdAt DateTime
    branchId  String   @db.Uuid
    branch    Branch   @relation(fields: [branchId], references: [id])

    @@index([branchId])
    @@index([createdAt])
    @@index([type])
}
