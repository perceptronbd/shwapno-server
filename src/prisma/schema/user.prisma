model User {
    id        String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
    firstName String     @map("first_name")
    lastName  String?    @map("last_name")
    email     String     @unique
    phone     String
    password  String
    userRoles UserRole[]
    Sale      Sale[]
    Audits    Audit[]    @relation("UserAudits")

    @@index([email])
}
