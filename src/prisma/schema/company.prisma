model Company {
    id       String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
    name     String   @unique
    location String?
    branches Branch[]
    roles    Role[]
}

model Branch {
    id            String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
    name          String           @unique
    location      String
    companyId     String           @db.Uuid
    qrImageURL    String?
    company       Company          @relation(fields: [companyId], references: [id])
    products      BranchProduct[]
    categories    BranchCategory[]
    userRoles     UserRole[]
    orders        Order[]
    stock         Stock[]
    notifications Notification[]
    Sale          Sale[]
    Audits        Audit[]          @relation("BranchAudits")

    @@index([companyId])
    @@index([name])
}
