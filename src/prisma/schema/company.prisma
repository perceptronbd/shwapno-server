model Company {
    id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
    imgURL    String?
    name      String   @unique
    location  String?
    branches  Branch[]
    roles     Role[]
    email     String?  @unique
    phone     String?
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@map("companies")
}

model Branch {
    id            String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
    name          String           @unique
    location      String
    companyId     String           @db.Uuid
    qrURL         String?
    company       Company          @relation(fields: [companyId], references: [id])
    categories    BranchCategory[]
    userRoles     UserRole[]
    orders        Order[]
    stock         Stock[]
    notifications Notification[]
    sale          Sale[]
    audits        Audit[]          @relation("BranchAudits")
    email         String?          @unique
    phone         String?
    createdAt     DateTime         @default(now())
    updatedAt     DateTime         @updatedAt

    @@index([companyId])
    @@index([name])
    @@map("branches")
}
