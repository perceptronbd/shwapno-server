// Add this model to your schema
model Job {
    id        String    @id @default(uuid())
    status    JobStatus @default(pending)
    progress  Int       @default(0)
    processed Int       @default(0)
    total     Int       @default(0)
    errors    Json?
    result    Json?
    createdAt DateTime  @default(now())
    updatedAt DateTime  @updatedAt

    @@map("jobs")
}

enum JobStatus {
    pending
    processing
    completed
    failed
}
