model Order {
    id          String      @id @default(uuid())
    customerId  String
    branchId    String
    orderDate   DateTime
    totalAmount Decimal
    status      OrderStatus
    items       OrderItem[]
    invoice     Invoice?
    customer    Customer    @relation(fields: [customerId], references: [id])
    branch      Branch      @relation(fields: [branchId], references: [id])
    sale        Sale?

    @@index([customerId])
    @@index([branchId])
    @@index([status])
    @@index([orderDate])
}

model OrderItem {
    id        String  @id @default(uuid())
    orderId   String
    productId String
    quantity  Int
    price     Decimal
    order     Order   @relation(fields: [orderId], references: [id])
    product   Product @relation(fields: [productId], references: [id])

    @@unique([orderId, productId])
    @@index([orderId])
    @@index([productId])
}

model Invoice {
    id          String   @id @default(uuid())
    orderId     String   @unique
    invoiceDate DateTime
    totalAmount Decimal
    order       Order    @relation(fields: [orderId], references: [id])

    @@index([invoiceDate])
}

enum OrderStatus {
    PENDING
    PROCESSING
    COMPLETED
    CANCELLED
    DELIVERED
    RETURNED
}
